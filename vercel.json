{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!Assets/).*)",
      "destination": "/Assets/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|mp4|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
